{
  "compilerOptions": {
    "jsx": "react",
    "moduleResolution": "node",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    },
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,       // Add this line
    "skipLibCheck": true           // Optionally, add this to skip type checking of declaration files
  }
}
